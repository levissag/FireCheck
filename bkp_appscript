function doGet(e) {
  const cod = e.parameter.cod;
  if (!cod) return HtmlService.createHtmlOutput("Código do extintor não informado.");

  const ss = SpreadsheetApp.openById("1iMx5Mc4-ayuoE95p5Kg4yqTp8peNHWNYRdeszSdPK8I");
  const sheet = ss.getSheetByName("extintores");
  const data = sheet.getDataRange().getValues();
  const header = data[0];

  const idxCod = header.indexOf("codextin");
  const idxEsquadrao = header.indexOf("esquadrao");
  const idxPredio = header.indexOf("predio");
  const idxLocal = header.indexOf("local");
  const idxTipo = header.indexOf("tipo");
  const idxCapacidade = header.indexOf("capacidade");

  // Procurar extintor pelo código
  let ext = null;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][idxCod]).toLowerCase() === cod.toLowerCase()) {
      ext = {
        codextin: data[i][idxCod],
        esquadrao: data[i][idxEsquadrao],
        predio: data[i][idxPredio],
        local: data[i][idxLocal],
        tipo: data[i][idxTipo],
        capacidade: data[i][idxCapacidade]
      };
      break;
    }
  }

  if (!ext) return HtmlService.createHtmlOutput("Extintor não encontrado.");

  // Cria o HTML com os dados do extintor + formulário
  return HtmlService.createHtmlOutput(`
    <html>
      <body style="font-family: Arial; padding: 20px;">
        <h2>Dados do Extintor</h2>
        <p><b>Código:</b> ${ext.codextin}</p>
        <p><b>Esquadrão:</b> ${ext.esquadrao}</p>
        <p><b>Prédio:</b> ${ext.predio}</p>
        <p><b>Local:</b> ${ext.local}</p>
        <p><b>Tipo:</b> ${ext.tipo}</p>
        <p><b>Capacidade:</b> ${ext.capacidade}</p>

        <h3>Registrar Vistoria</h3>
        <label>Vistoriador:</label><br>
        <select id="vistoriador">
          <option>S1 GUAZINA</option>
          <option>S2 BRUNO PEREIRA</option>
          <option>S2 CARVALHO</option>
        </select><br><br>

        <label>Data da Vistoria:</label><br>
        <input type="date" id="dataVist" value="${new Date().toISOString().split("T")[0]}"><br><br>

        <label>Observações:</label><br>
        <textarea id="obs" style="width:300px; height:80px;"></textarea><br><br>

        <button onclick="enviar()">Salvar Vistoria</button>
        <p id="status"></p>

        <script>
          function enviar() {
            const payload = {
              codextin: "${ext.codextin}",
              vistoriador: document.getElementById("vistoriador").value,
              datavist: document.getElementById("dataVist").value,
              obs: document.getElementById("obs").value
            };

            google.script.run.withSuccessHandler(function(res) {
              document.getElementById("status").innerText = 
                "Resposta: " + JSON.stringify(res);
            }).salvarVistoria(payload);
          }
        </script>
      </body>
    </html>
  `);
}

// Função que recebe os dados do formulário e salva na planilha
function salvarVistoria(dados) {
  try {
    const ss = SpreadsheetApp.openById("1iMx5Mc4-ayuoE95p5Kg4yqTp8peNHWNYRdeszSdPK8I");
    const sheet = ss.getSheetByName("extintores");

    // Encontrar a linha do extintor
    const data = sheet.getDataRange().getValues();
    const header = data[0];
    const idxCod = header.indexOf("codextin");
    const idxVist = header.indexOf("vistoriador") || 7; // exemplo: coluna H
    const idxDataVist = header.indexOf("datavist") || 8;  // exemplo: coluna I
    const idxObs = header.indexOf("obs") || 9;            // exemplo: coluna J

    let linha = -1;
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][idxCod]).toLowerCase() === dados.codextin.toLowerCase()) {
        linha = i + 1;
        break;
      }
    }

    if (linha === -1) return { status: "error", msg: "Extintor não encontrado" };

    // Atualiza os campos
    sheet.getRange(linha, idxVist + 1).setValue(dados.vistoriador);
    sheet.getRange(linha, idxDataVist + 1).setValue(dados.datavist);
    sheet.getRange(linha, idxObs + 1).setValue(dados.obs);

    return { status: "ok", msg: "Vistoria salva com sucesso" };
  } catch (err) {
    return { status: "error", msg: err.toString() };
  }
}
