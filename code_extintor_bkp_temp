function getDadosExtintor(codigo) {
  const cod = e.parameter.codigo;
  if (!cod) return HtmlService.createHtmlOutput("Código do extintor não informado.");

  const ss = SpreadsheetApp.openById("1iMx5Mc4-ayuoE95p5Kg4yqTp8peNHWNYRdeszSdPK8I");
  const sheet = ss.getSheetByName("extintores");
  const data = sheet.getDataRange().getValues();
  const header = data[0];

  const idxCod = header.indexOf("codextin");
  const idxEsquadrao = header.indexOf("esquadrao");
  const idxPredio = header.indexOf("predio");
  const idxLocal = header.indexOf("local");
  const idxTipo = header.indexOf("tipo");
  const idxCapacidade = header.indexOf("capacidade");
  const idxDataVist = header.indexOf("datavist");   // <-- ADICIONADO

    // Procurar extintor
  let ext = null;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][idxCod]).toLowerCase() === cod.toLowerCase()) {
      ext = {
        codextin: data[i][idxCod],
        esquadrao: data[i][idxEsquadrao],
        predio: data[i][idxPredio],
        local: data[i][idxLocal],
        tipo: data[i][idxTipo],
        capacidade: data[i][idxCapacidade],
        datavist: data[i][idxDataVist] ? Utilities.formatDate(new Date(data[i][idxDataVist]), Session.getScriptTimeZone(), "dd/MM/yyyy"): "—"
      };
      break;
    }
  }

  if (!ext) return HtmlService.createHtmlOutput("<center><h3>Extintor não encontrado.</h3></center>");

  // --- Calcular status da última vistoria (servidor) ---
  let statusVistoriaHtml = "";
  if (!ext.datavist || ext.datavist === "—") {
    statusVistoriaHtml = `<span style="color: red; font-weight: bold;">Sem registro de vistoria</span>`;
  } else {
    // tenta extrair dd/mm/yyyy com regex
    const m = ext.datavist.match(/^\s*(\d{2})\/(\d{2})\/(\d{4})\s*$/);
    if (!m) {
      statusVistoriaHtml = `<span style="color: orange; font-weight: bold;">Data inválida</span>`;
    } else {
      const d = parseInt(m[1], 10);
      const mo = parseInt(m[2], 10) - 1;
      const y = parseInt(m[3], 10);
      const dataV = new Date(y, mo, d);
      const hoje = new Date();
      const diff = Math.floor((hoje - dataV) / (1000 * 60 * 60 * 24));

      if (isNaN(diff)) {
        statusVistoriaHtml = `<span style="color: orange; font-weight: bold;">Data inválida</span>`;
      } else if (diff > 30) {
        statusVistoriaHtml = `<span style="color: red; font-weight: bold;">⚠️ VENCIDO há ${diff} dias</span>`;
      } else {
        const restantes = 30 - diff;
        statusVistoriaHtml = `<span style="color: #00e676; font-weight: bold;">✔ Dentro da validade (${restantes} dias restantes)</span>`;
      }
    }
  }


  const template = HtmlService.createTemplateFromFile('view_extintor');
  template.codigo = codigo;
  return template.evaluate()
    .setTitle('Extintor ' + codigo)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);

}

function validarCPF(cpf) {
  cpf = String(cpf).replace(/\D/g, "").trim(); // remove pontos/traços/espaços

  const ss = SpreadsheetApp.openById("1iMx5Mc4-ayuoE95p5Kg4yqTp8peNHWNYRdeszSdPK8I");
  const sheet = ss.getSheetByName("var_vistor");

  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    const nome = data[i][0]; // Coluna A
    const cpfPlanilha = String(data[i][1]).replace(/\D/g, "").trim(); // Coluna B LIMPO

    if (cpfPlanilha === cpf) {
      return { ok: true, nome: nome };
    }
  }

  return { ok: false, msg: "CPF não encontrado." };
}

function salvarVistoria(dados) {
  try {
    const ss = SpreadsheetApp.openById("1iMx5Mc4-ayuoE95p5Kg4yqTp8peNHWNYRdeszSdPK8I");
    const sheet = ss.getSheetByName("extintores");

    const data = sheet.getDataRange().getValues();
    const header = data[0];

    // Índices das colunas
    const idxCod = header.indexOf("codextin");

    const idxEsq = header.indexOf("esquadrao");
    const idxPred = header.indexOf("predio");
    const idxLocal = header.indexOf("local");
    const idxTipo = header.indexOf("tipo");
    const idxCap = header.indexOf("capacidade");

    const idxVist = header.indexOf("vistoriador");
    const idxDataVist = header.indexOf("datavist");
    const idxObs = header.indexOf("obs");

    // Encontrar linha do extintor
    let linha = -1;
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][idxCod]).toLowerCase() === dados.codextin.toLowerCase()) {
        linha = i + 1;
        break;
      }
    }

    if (linha === -1) 
      return { status: "error", msg: "Extintor não encontrado" };

    // Atualizar dados
    sheet.getRange(linha, idxEsq + 1).setValue(dados.esquadrao);
    sheet.getRange(linha, idxPred + 1).setValue(dados.predio);
    sheet.getRange(linha, idxLocal + 1).setValue(dados.local);
    sheet.getRange(linha, idxTipo + 1).setValue(dados.tipo);
    sheet.getRange(linha, idxCap + 1).setValue(dados.capacidade);

    sheet.getRange(linha, idxVist + 1).setValue(dados.vistoriador);
    sheet.getRange(linha, idxDataVist + 1).setValue(dados.datavist);
    sheet.getRange(linha, idxObs + 1).setValue(dados.obs);

    return { status: "ok", msg: "Vistoria salva com sucesso" };

  } catch (err) {
    return { status: "error", msg: err.toString() };
  }
}
